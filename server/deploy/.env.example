# 复制这个文件成 .env，把下面的值填成真实的，然后放到服务器上
# /opt/soul-lantern/.env —— 这份 .env 只应该存在于服务器上，不要复制回你电脑、
# 更不要发给任何人（包括发给我）。
#
# 改完之后先跑一次自检再重启，别直接 restart：
#   sudo -u soul-lantern /opt/soul-lantern/soul-lantern-server --check
# 它会把下面每一项都验一遍并告诉你缺什么，而且**不绑定端口**，
# 所以在服务还跑着的时候也能安全地跑。

# ================= 必填：缺了服务起不来 =================

# 真实大模型 key。DashScope 控制台建议给这个 key 加"仅允许从本服务器公网 IP
# 调用"的白名单，多一层保护。
AI_API_KEY=sk-替换成你的真实key

# 上游接口地址 + 模型名。
# 注意：这个地址以控制台"查看调用示例代码"那页给出的为准。之前用过一个绑定
# 工作空间的专属网关地址，后来失效直接 404 了——报 404 优先怀疑这一行。
AI_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_MODEL=qwen-plus

# 账号体系的根密钥：会话 token 摘要、验证码摘要、激活码校验位全靠它。
# 生成一个：openssl rand -base64 48
#
# 【一旦设定就不要更换】换了会同时导致三件事：所有人掉线、所有已发出去的
# 激活码全部作废、进行中的注册/找回密码全部失效。
AUTH_PEPPER=换成 openssl rand -base64 48 生成的随机串

# ================= 短信验证码 =================

# log | aliyun
#   log    —— 验证码只打进 journalctl，不真的发短信。开发用，也是救火通道：
#             短信服务出问题时切到这个值 + restart，让用户把手机号报给你，
#             你从 journalctl -u soul-lantern 里捞码告诉他。
#   aliyun —— 真的发短信。正式环境用这个。
SMS_KIND=aliyun

# 以下三项只有 SMS_KIND=aliyun 时才需要。
#
# 走的是阿里云「号码认证服务（PNVS）」里的**短信认证**功能，不是常规的
# 「短信服务（SMS）」——后者要求签名做运营商实名报备，个人认证过不了那一关。
# 短信认证的签名和模板是阿里云自己的、已报备过，个人实名认证就能用，
# 不需要营业执照、不需要域名、不需要 ICP 备案。
#
# 开通步骤：阿里云控制台 → 号码认证服务 → 只勾选「开通短信认证产品」
# （一键登录/图形认证/融合认证那几个都用不上）→ 在「赠送签名配置」页面
# 拿到签名名称填到下面。
#
# 计费：约 0.042 元/条按量付费，无免费额度。小额套餐包（100次5元/1千次50元）
# 折算下来是 0.05 元/条，**比按量付费还贵**，要到 5 万次以上才划算——
# 你这个量级直接按量付费，不用买套餐包。
SMS_ACCESS_KEY_ID=替换成阿里云 AccessKey ID
SMS_ACCESS_KEY_SECRET=替换成阿里云 AccessKey Secret
# 从号码认证服务控制台「赠送签名配置」页面复制，不能自定义。
# 用户收到的短信开头方括号里就是这个名字，不会是「灵魂灯笼」——
# 客户端注册界面已经加了提示告诉用户这件事，别删那段文案。
SMS_SIGN_NAME=替换成控制台给的赠送签名名称

# ================= 选填：都有默认值 =================

# 接口地址。一般不用改，留成可配是为了万一阿里云换了端点，改这里就行不用重编译。
#SMS_ENDPOINT=dypnsapi.aliyuncs.com

# 每日发短信总量上限，防被刷爆钱包。默认 200。
# 其中 40% 是预留给"重发"和"已注册用户找回密码"的——这两类的目标手机号
# 一定是系统已知的，攻击者要占用得先有账号。剩下 60% 给新号注册。
# 这样就算新号注册配额被刷光，已有用户还是能找回密码。
#SMS_DAILY_CAP=200

# 同一手机号两次发码的最小间隔（秒），默认 60。
# register / 重发 / 找回密码三条流程**共用**这个冷却，分开计数等于送攻击者
# 三倍配额。设成 0 只应该出现在自动化测试里。
#SMS_MIN_INTERVAL_SECS=60

# 设了才会注册 /v1/admin/* 那几个排障接口；不设的话它们连路径都不存在
# （返回 404 而不是 403，攻击者探不到）。建议设上，出问题时很有用：
#   查用户：  curl.exe --cacert server.crt -H "Authorization: Bearer <token>" ^
#             "https://120.26.175.121:8443/v1/admin/lookup?q=13800138000"
#   发测试短信：/v1/admin/sms-test?to=你的手机号   （原样透出阿里云的报错）
#   看统计：  /v1/admin/stats
# 生成一个：openssl rand -base64 32
#ADMIN_TOKEN=

# 客户端登录门禁的逃生开关。设成 false 时客户端不再要求登录——
# 万一短信通道整个挂了、新用户注册不进来，用这个先让老用户能用，
# 不用重新发一版安装包。修好之后记得改回来。
#AUTH_REQUIRED=true

# 日志级别。**必须显式设置**：tracing-subscriber 开了 env-filter 之后，
# RUST_LOG 没设时默认只放行 ERROR，会把启动日志和 SMS_KIND=log 的验证码
# 一起静音。
RUST_LOG=info

# 一般不用改，跟 systemd 配置里的路径对应
TLS_CERT=/opt/soul-lantern/server.crt
TLS_KEY=/opt/soul-lantern/server.key
LEDGER_PATH=/opt/soul-lantern/ledger.json
BIND_ADDR=0.0.0.0:8443
