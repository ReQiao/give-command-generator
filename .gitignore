# =========================
# Rust / Cargo
# =========================
/target/
**/target/

# Cargo.lock:
# - 对应用程序 / Tauri 桌面程序：建议提交 Cargo.lock
# - 对纯 Rust 库 crate：可以考虑忽略 Cargo.lock
# 默认不忽略 Cargo.lock
# Cargo.lock

# Rust backup files
**/*.rs.bk

# Rust profiling / coverage
*.profraw
*.profdata
*.gcda
*.gcno
coverage/
tarpaulin-report.html
cobertura.xml
lcov.info

# Rust analyzer / language server cache
.ra_cache/
.rust-analyzer/


# =========================
# Node / Vue / TypeScript / Vite
# =========================
node_modules/
**/node_modules/

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
.output/
.nuxt/
.vite/
.vite-inspect/

# TypeScript incremental build cache
*.tsbuildinfo

# Vite / Vue cache
.cache/
.eslintcache
.stylelintcache

# VuePress / VitePress
.vuepress/dist/
.vitepress/dist/
.vitepress/cache/


# =========================
# Tauri
# =========================
/src-tauri/target/
/src-tauri/gen/
/src-tauri/.cargo/

# Tauri generated icons / temporary assets, if regenerated by build tools
