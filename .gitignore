# /src-tauri/icons/

# Tauri bundler outputs
/src-tauri/target/release/bundle/
/src-tauri/target/debug/bundle/

# Tauri local config overrides
src-tauri/tauri.conf.local.json
src-tauri/tauri.*.local.json

# Tauri signing keys / private keys
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der
*.csr
*.mobileprovision
*.provisionprofile

# Tauri updater/signing secrets
src-tauri/private.key
src-tauri/*.key
src-tauri/*.pem


